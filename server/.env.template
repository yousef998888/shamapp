# Database Configuration
DATABASE_URL=postgresql://postgres:your-super-secret-and-long-postgres-password@127.0.0.1:5432/postgres
# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

OPENAI_API_KEY=
# Server Configuration
PORT=3005
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880


# DELIVARY API INFO
DELIVARY_API_URL="https://guba-sy.com"
DELIVARY_API_TOKEN=

# Optional API Configuration
DELIVARY_API_TIMEOUT=30000
DELIVARY_API_RETRY_ATTEMPTS=3
DELIVARY_API_RETRY_DELAY=1000

# Service Configuration
SHIPPING_FALLBACK_TO_MOCK=true
SHIPPING_LOG_LEVEL=info
SHIPPING_ENABLE_CACHE=true
SHIPPING_CACHE_TTL=300000